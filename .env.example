# Copy this file to .env and fill in the two blanks. .env is gitignored.
# Do not commit a billing account id, or a project id you have already created.
#
# A project id is 6 to 30 characters, starts with a letter, ends with a letter
# or a digit, and cannot be reused after that project is deleted. Deletion can
# take up to 30 days. The picture uses twotier-poc-zeon01 as a placeholder.
# Pick a fresh id here when you build. The scripts read this file. They do not
# fall back to whatever project the gcloud command-line interface is pointed at.

# Replace yourname01 with your own short name and a number. The project id
# has to be unique across all of Google Cloud.
GCP_PROJECT_ID=twotier-poc-yourname01
GCP_BILLING_ACCOUNT=
GCP_REGION=us-east1
